{
  "manifest_version": 3,
  "name": "Meu Repertório — Importar cifra",
  "version": "0.1.0",
  "description": "Importa a cifra da música selecionada no Meu Repertório pelo navegador.",
  "icons": { "128": "icon-128.png" },
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting"],
  "host_permissions": ["https://www.cifraclub.com.br/*"],
  "externally_connectable": {
    "matches": [
      "https://easy-show-next.vercel.app/*",
      "https://www.meurepertorio.com/*",
      "https://meurepertorio.com/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
