{
  "manifest_version": 3,
  "name": "Toca Mais Uma — Importar cifra",
  "version": "0.3.0",
  "description": "Busca e importa cifras (Cifra Club, Cifras.com.br e Ultimate Guitar) para o Toca Mais Uma pelo navegador.",
  "icons": { "128": "icon-128.png" },
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://www.cifraclub.com.br/*",
    "https://www.cifras.com.br/*",
    "https://www.ultimate-guitar.com/*",
    "https://tabs.ultimate-guitar.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://tocamaisuma.com.br/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
