# Copie este arquivo para `.env.local` e preencha com os valores do seu projeto Firebase:
#   cp .env.example .env.local
#
# Os valores ficam em: Firebase Console > Configurações do projeto > Geral >
# "Seus apps" > app Web > SDK setup and configuration (objeto `firebaseConfig`).
# Lidos em `firebaseConfig.ts`.

# firebaseConfig.apiKey
NEXT_PUBLIC_REACT_APP_API_KEY=

# firebaseConfig.authDomain (ex.: seu-projeto.firebaseapp.com)
NEXT_PUBLIC_REACT_APP_AUTH_DOMAIN=

# firebaseConfig.projectId (ex.: seu-projeto)
NEXT_PUBLIC_REACT_APP_PROJECT_ID=

# firebaseConfig.storageBucket (ex.: seu-projeto.appspot.com)
NEXT_PUBLIC_REACT_APP_STORAGE_BUCKET=

# firebaseConfig.messagingSenderId
# Atenção: sem o prefixo NEXT_PUBLIC_, o Next.js não expõe esta variável no browser,
# então ela só é lida no servidor. Não é necessária para Auth/Firestore.
REACT_APP_MESSAGIN_SENDER_ID=

# firebaseConfig.appId
NEXT_PUBLIC_REACT_APP_APP_ID=

# firebaseConfig.measurementId (opcional, Google Analytics)
NEXT_PUBLIC_REACT_APP_MEASUREMENT_ID=
