rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin é marcado à mão no console (users/{uid}.isAdmin = true).
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Perfil: só o próprio usuário lê e grava, e nunca consegue se tornar admin.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && !('isAdmin' in request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
      allow delete: if false;
    }

    // Cifras: catálogo público e colaborativo para quem está logado.
    // Listagem limitada a páginas pequenas (evita cópia em massa do catálogo).
    match /lyrics/{lyricId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Artistas: mesmo modelo das cifras.
    match /composers/{composerId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // Repertórios: privados de cada usuário.
    match /sheetsMusics/{sheetId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    // Tom e estrelas de cada música por usuário: privados.
    match /userLyricsRegistered/{registeredId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    // Playbacks (mp3 sincronizado com a cifra): privados do dono.
    // O app cria e renomeia; status/linha do tempo/cifra gerada são gravados pela Cloud Function (Admin SDK).
    // Playback enviado na tela de adicionar música nasce sem música (lyricId '') e é ligado a ela uma vez, ao salvar.
    match /playbacks/{playbackId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.status == 'uploading'
        && !('generated' in request.resource.data);
      allow update: if isOwner(resource.data.userId)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'updatedAt'])
          || (resource.data.lyricId == ''
            && request.resource.data.lyricId is string && request.resource.data.lyricId != ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lyricId', 'updatedAt'])));
    }

    // Qualquer outra coleção fica fechada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
