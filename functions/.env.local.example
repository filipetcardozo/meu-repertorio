# Só para os emuladores (não vai para produção): o processamento do playback (faixas, voz, sincronia)
# roda no contêiner local do worker (worker/), apontando para os emuladores.
# Gere a imagem local com (na raiz do repositório):
#   docker build -f worker/Dockerfile --target local -t meu-repertorio-worker .
# STEMS_MODEL vem do ambiente de quem iniciou os emuladores: vazio = Demucs (como em produção);
# bs-roformer-sw = BS-RoFormer (só local). Os pesos dele ficam no volume meu-repertorio-roformer.
# (Para testar com o banco de produção e o processamento no PC, use `yarn dev:local`.)
PROCESS_LOCAL_CMD=docker run --rm -e FIRESTORE_EMULATOR_HOST=host.docker.internal:8080 -e STORAGE_EMULATOR_HOST=http://host.docker.internal:9199 -e GOOGLE_CLOUD_PROJECT=avid-bricolage-313721 -e STORAGE_BUCKET=avid-bricolage-313721.appspot.com -e STEMS_MODEL -v meu-repertorio-roformer:/models/roformer meu-repertorio-worker {playbackId}
