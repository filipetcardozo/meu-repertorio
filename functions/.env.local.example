# Só para os emuladores (não vai para produção): a separação de instrumentos roda no contêiner local
# do worker (stems/), apontando para os emuladores. Gere a imagem com: docker build -t meu-repertorio-stems stems
STEMS_LOCAL_CMD=docker run --rm -e FIRESTORE_EMULATOR_HOST=host.docker.internal:8080 -e STORAGE_EMULATOR_HOST=http://host.docker.internal:9199 -e GOOGLE_CLOUD_PROJECT=avid-bricolage-313721 -e STORAGE_BUCKET=avid-bricolage-313721.appspot.com meu-repertorio-stems {playbackId}
